+			httpAddr:      httpAddr,
+			openfgaClient: openfgav1.NewOpenFGAServiceClient(conn),
+			authzenClient: authzenv1.NewAuthZenServiceClient(conn),
+		}
+	}
+
 	cfg := testutils.MustDefaultConfig()
