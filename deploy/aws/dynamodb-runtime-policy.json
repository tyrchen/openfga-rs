{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OpenFgaDynamoDbDataPlane",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:TransactWriteItems",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/TABLE_NAME"
    },
    {
      "Sid": "DenyUnneededDynamoDbOperations",
      "Effect": "Deny",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:Scan",
        "dynamodb:UpdateTable"
      ],
      "Resource": "*"
    }
  ]
}
